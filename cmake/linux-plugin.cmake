project(window-dock VERSION 1.1.0 LANGUAGES CXX)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_AUTOMOC ON)
include(GNUInstallDirs)
find_package(libobs REQUIRED)
find_package(obs-frontend-api REQUIRED)
find_package(Qt6 6.5 REQUIRED COMPONENTS Widgets Quick QuickWidgets WaylandCompositor)
find_package(X11 REQUIRED)
add_library(window-dock-backends STATIC src/linux/backends.cpp src/linux/backends.hpp)
set_target_properties(window-dock-backends PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_link_libraries(window-dock-backends PUBLIC Qt6::Widgets Qt6::Quick Qt6::QuickWidgets Qt6::WaylandCompositor X11::X11)
target_compile_options(window-dock-backends PRIVATE -Wall -Wextra -Wpedantic)
add_library(window-dock MODULE src/linux/plugin.cpp)
set_target_properties(window-dock PROPERTIES PREFIX "")
target_link_libraries(window-dock PRIVATE window-dock-backends OBS::libobs OBS::obs-frontend-api)
install(TARGETS window-dock LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}/obs-plugins)
install(FILES LICENSE-LINUX DESTINATION ${CMAKE_INSTALL_DATAROOTDIR}/licenses/window-dock)
option(WINDOW_DOCK_BUILD_TESTS "Build the standalone backend integration tests" OFF)
if(WINDOW_DOCK_BUILD_TESTS)
  enable_testing()
  find_package(Qt6 REQUIRED COMPONENTS Test)
  add_executable(window-dock-tests tests/backends.cpp)
  target_link_libraries(window-dock-tests PRIVATE window-dock-backends Qt6::Test)
  add_test(NAME window-dock-backends COMMAND window-dock-tests)
endif()
set(CPACK_PACKAGE_NAME obs-studio-plugin-window-dock)
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_PACKAGE_CONTACT "https://github.com/kamm3r/window-dock")
set(CPACK_RPM_PACKAGE_LICENSE GPL-3.0-or-later)
set(CPACK_RPM_PACKAGE_SUMMARY "Interactive Xorg and nested Wayland docks for OBS")
set(CPACK_RPM_PACKAGE_REQUIRES "obs-studio >= 30")
set(CPACK_RPM_EXCLUDE_FROM_AUTO_FILELIST_ADDITION "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_LIBDIR}/obs-plugins;${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_DATAROOTDIR}/licenses")
include(CPack)
